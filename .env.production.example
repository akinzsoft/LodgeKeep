# LodgeKeep — production environment. Copy to `.env.production`, fill in
# every value, and never commit the filled-in file (.gitignore already
# excludes it explicitly — .env.*.local's own pattern doesn't match this
# literal filename, so this repo's .gitignore has a dedicated line for it).
#
# Loaded two ways by docker-compose.prod.yml, and must be the SAME file for
# both:
#   1. `docker compose --env-file .env.production -f docker-compose.prod.yml ...`
#      — substitutes every ${VAR} placeholder inside the compose YAML.
#   2. `env_file: [.env.production]` on the backend/migrate services — loads
#      these same key=value pairs directly into that container's own
#      process environment.
#
# NOT included below: DB_HOST, DB_PORT, REDIS_HOST, REDIS_PORT, NODE_ENV.
# Those are hardcoded to the correct Docker-network values directly in
# docker-compose.prod.yml's own `environment:` block (which overrides
# env_file for the same key) — deliberately not overridable here, to
# remove one whole class of misconfiguration.
#
# Also not needed here at all: PORT (defaults to 3000 via
# backend/Dockerfile's own ENV, matching the compose file's internal
# backend:3000 references — no need to pin it a second time) and
# DB_NAME_TEST (backend/knexfile.js's `test` config is a lazy getter
# specifically so a production process never evaluates it, and never
# needs this var set at all).

# --- Domain & TLS ------------------------------------------------------
# The real registered domain tenants log in under (e.g. lodgekeep.app).
# Needs a wildcard DNS record — *.<APP_DOMAIN> -> this VPS's public IP —
# before Caddy's on-demand TLS can ever see a request for a new tenant
# subdomain (docker/frontend/Caddyfile). Set this up as its own step;
# nothing in this stack can create the DNS record for you.
APP_DOMAIN=
# Contact address Let's Encrypt uses for certificate expiry/problem notices.
ACME_EMAIL=

# Cloudflare Turnstile PUBLIC site key — the frontend's own build-time
# counterpart to TURNSTILE_SECRET_KEY above. Threaded into the actual
# built JS bundle via docker-compose.prod.yml's `frontend.build.args`
# (Vite inlines `import.meta.env.VITE_*` at build time, not read at
# container-start time the way a backend env var is) — this is why it
# lives here, at the top of this file with the other domain-facing
# values, not down in the backend-only secrets section below.
VITE_TURNSTILE_SITE_KEY=

# --- MySQL ---------------------------------------------------------------
DB_NAME=lodgekeep_prod
DB_USER=lodgekeep
DB_PASSWORD=
# Required for the mysql:8 image to even initialize on its first start (no
# data volume yet) — leaving this blank makes the mysql container fail to
# come up the very first time, not merely "insecure."
MYSQL_ROOT_PASSWORD=
# ~1/6 of a 12GB box that also runs Redis, the Node backend (all 9 BullMQ
# workers in-process — no separate worker deploy), and Caddy. Comfortably
# larger than a demo's real working set while leaving headroom for
# everything else sharing the box. Raise later by editing this one value.
MYSQL_INNODB_BUFFER_POOL_SIZE=2G

# --- Redis -----------------------------------------------------------------
# Required — the redis container is started with --requirepass; an empty
# value here means an unauthenticated Redis reachable by every other
# container on this compose network.
REDIS_PASSWORD=

# --- Application secrets -------------------------------------------------
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_PLATFORM_ACCESS_TTL=30m
IMPERSONATION_SESSION_MINUTES=60
PLATFORM_MFA_ISSUER=LodgeKeep Platform
TRIAL_PERIOD_DAYS=14
# 32 raw bytes, base64-encoded (src/shared/encryption.js requires exactly
# this — a plain 32-character string decodes to only 24 bytes and fails at
# first use). Generate with:
#   openssl rand -base64 32
# Back this up exactly like a database credential — rotating it makes every
# already-encrypted value (email_settings.smtp_password_encrypted)
# permanently undecryptable.
ENCRYPTION_KEY=

# Security-review finding: CAPTCHA screening on the public POST /signup
# endpoint (backend/src/shared/captcha-verify.js) — Cloudflare Turnstile.
# REQUIRED — backend/src/shared/startup-checks.js refuses to start the
# backend container at all without this set. Get a real secret key (and
# its matching public site key, VITE_TURNSTILE_SITE_KEY below) from a real
# Turnstile site at https://dash.cloudflare.com/?to=/:account/turnstile —
# never use the dummy testing keys documented in backend/.env.example
# for an actual production deployment.
TURNSTILE_SECRET_KEY=

# --- Payments (guest-to-hotel, Cashiering) --------------------------------
PAYSTACK_SECRET_KEY=

# --- Email -----------------------------------------------------------------
# "console" logs every outbox email to stdout instead of sending — a safe
# default if no real mailbox is configured yet for the demo.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=LodgeKeep

# --- Subscription billing (Planmsys charging a TENANT — a separate
#     merchant relationship from Cashiering above) -------------------------
BILLING_PAYSTACK_SECRET_KEY=
BILLING_PAYSTACK_PUBLIC_KEY=
BILLING_CARD_VERIFICATION_AMOUNT=50.00
SUBSCRIPTION_BILLING_SWEEP_INTERVAL_MS=60000
# Retry sweep for Paystack webhook events persisted but not yet decided
# (Paystack unreachable / transaction not final). Milliseconds.
PAYMENT_WEBHOOK_SWEEP_INTERVAL_MS=60000
# Upper bound for the Verify Transaction call a webhook makes to Paystack.
PAYSTACK_READ_TIMEOUT_MS=8000

# --- Local-disk storage (paths INSIDE the backend container — each has a
#     matching named volume mounted onto it in docker-compose.prod.yml, so
#     uploaded files survive a container recreation) -----------------------
EXPORT_STORAGE_DIR=/app/storage/exports
IMPORT_STORAGE_DIR=/app/storage/imports
MENU_IMAGE_STORAGE_DIR=/app/storage/menu-images
# Property-branding logos (GET /api/v1/media/property-logos/:file, also
# used on the P&L PDF letterhead) — a fourth, previously undocumented
# storage var, the same pattern as the three above it.
PROPERTY_LOGO_STORAGE_DIR=/app/storage/property-logos
