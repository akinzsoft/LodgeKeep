# LodgeKeep — production environment. Copy to `.env.production`, fill in
# every value, and never commit the filled-in file (.gitignore already
# excludes it explicitly — .env.*.local's own pattern doesn't match this
# literal filename, so this repo's .gitignore has a dedicated line for it).
#
# Loaded two ways by docker-compose.prod.yml, and must be the SAME file for
# both:
#   1. `docker compose --env-file .env.production -f docker-compose.prod.yml ...`
#      — substitutes every ${VAR} placeholder inside the compose YAML.
#   2. `env_file: [.env.production]` on the backend/migrate services — loads
#      these same key=value pairs directly into that container's own
#      process environment.
#
# NOT included below: DB_HOST, DB_PORT, REDIS_HOST, REDIS_PORT, NODE_ENV.
# Those are hardcoded to the correct Docker-network values directly in
# docker-compose.prod.yml's own `environment:` block (which overrides
# env_file for the same key) — deliberately not overridable here, to
# remove one whole class of misconfiguration.
#
# Also not needed here at all: PORT (defaults to 3000 via
# backend/Dockerfile's own ENV, matching the compose file's internal
# backend:3000 references — no need to pin it a second time) and
# DB_NAME_TEST (backend/knexfile.js's `test` config is a lazy getter
# specifically so a production process never evaluates it, and never
# needs this var set at all).

# --- Domain & TLS ------------------------------------------------------
# The real registered domain tenants log in under (e.g. lodgekeep.app).
# Needs a wildcard DNS record — *.<APP_DOMAIN> -> this VPS's public IP —
# before Caddy's on-demand TLS can ever see a request for a new tenant
# subdomain (docker/frontend/Caddyfile). Set this up as its own step;
# nothing in this stack can create the DNS record for you.
APP_DOMAIN=
# Two-domain support (leave both EMPTY unless you are adding a second domain). PRIMARY_APP_DOMAIN is the domain
# outgoing links and the signup redirect use (empty = APP_DOMAIN). ADDITIONAL_APP_DOMAINS is a comma-separated list of
# other bare domains that are also accepted (requests, TLS, payment callbacks, the landing page). Bare host names
# only: no scheme, port, path or wildcard. Each needs its own wildcard DNS record (*.<domain>).
# Moving from lodgekeep.planmsys.com to lodgekeep.ng, in this order, redeploying after each step:
#   1. ADDITIONAL_APP_DOMAINS=lodgekeep.ng                       (both work; links still use the old domain)
#   2. PRIMARY_APP_DOMAIN=lodgekeep.ng
#      ADDITIONAL_APP_DOMAINS=lodgekeep.planmsys.com             (links now use lodgekeep.ng; the old domain still works)
PRIMARY_APP_DOMAIN=
ADDITIONAL_APP_DOMAINS=
# Where a tenant is reached in e-mailed links: while on trial, and once subscribed. Each must be one of the accepted domains
# above (PRIMARY_APP_DOMAIN / ADDITIONAL_APP_DOMAINS); empty = the primary. Stored per tenant (tenants.app_domain) when the tenant
# signs up and when it is marked subscribed, so changing these later does not move existing tenants.
# REQUIRED before deploying: the 20261207090000 migration writes it onto EVERY existing tenant (set it to the domain tenants use
# today) and refuses to run if it is empty. Nobody changes domain at deploy.
TRIAL_APP_DOMAIN=
SUBSCRIBED_APP_DOMAIN=
# Contact address Let's Encrypt uses for certificate expiry/problem notices.
ACME_EMAIL=

# Cloudflare Turnstile PUBLIC site key — the frontend's own build-time
# counterpart to TURNSTILE_SECRET_KEY above. Threaded into the actual
# built JS bundle via docker-compose.prod.yml's `frontend.build.args`
# (Vite inlines `import.meta.env.VITE_*` at build time, not read at
# container-start time the way a backend env var is) — this is why it
# lives here, at the top of this file with the other domain-facing
# values, not down in the backend-only secrets section below.
VITE_TURNSTILE_SITE_KEY=

# --- MySQL ---------------------------------------------------------------
DB_NAME=lodgekeep_prod
DB_USER=lodgekeep
DB_PASSWORD=
# Required for the mysql:8 image to even initialize on its first start (no
# data volume yet) — leaving this blank makes the mysql container fail to
# come up the very first time, not merely "insecure."
MYSQL_ROOT_PASSWORD=
# ~1/6 of a 12GB box that also runs Redis, the Node backend (all 9 BullMQ
# workers in-process — no separate worker deploy), and Caddy. Comfortably
# larger than a demo's real working set while leaving headroom for
# everything else sharing the box. Raise later by editing this one value.
MYSQL_INNODB_BUFFER_POOL_SIZE=2G

# --- Redis -----------------------------------------------------------------
# Required — the redis container is started with --requirepass; an empty
# value here means an unauthenticated Redis reachable by every other
# container on this compose network.
REDIS_PASSWORD=

# --- Application secrets -------------------------------------------------
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_PLATFORM_ACCESS_TTL=30m
IMPERSONATION_SESSION_MINUTES=60
PLATFORM_MFA_ISSUER=LodgeKeep Platform
TRIAL_PERIOD_DAYS=14
# 32 raw bytes, base64-encoded (src/shared/encryption.js requires exactly
# this — a plain 32-character string decodes to only 24 bytes and fails at
# first use). Generate with:
#   openssl rand -base64 32
# Back this up exactly like a database credential — rotating it makes every
# already-encrypted value (email_settings.smtp_password_encrypted)
# permanently undecryptable.
ENCRYPTION_KEY=

# Security-review finding: CAPTCHA screening on the public POST /signup
# endpoint (backend/src/shared/captcha-verify.js) — Cloudflare Turnstile.
# REQUIRED — backend/src/shared/startup-checks.js refuses to start the
# backend container at all without this set. Get a real secret key (and
# its matching public site key, VITE_TURNSTILE_SITE_KEY below) from a real
# Turnstile site at https://dash.cloudflare.com/?to=/:account/turnstile —
# never use the dummy testing keys documented in backend/.env.example
# for an actual production deployment.
TURNSTILE_SECRET_KEY=

# --- Payments (guest-to-hotel, Cashiering) --------------------------------
PAYSTACK_SECRET_KEY=
# Who pays Paystack's transaction fee on a guest/POS card payment that is split to a hotel
# subaccount: `subaccount` (default) = the hotel's subaccount bears it, so the platform account
# is NOT charged; `account` = the main (platform) account bears it. Sent as `bearer` on
# /transaction/initialize; transaction_charge is never sent. Anything else stops the app at boot.
# DELIBERATE BEHAVIOUR CHANGE: before this setting existed no bearer was sent, so Paystack's
# default applied (the main account paid). Existing deployments now default to `subaccount`.
# Set `account` to keep the old behaviour.
PAYSTACK_FEE_BEARER=subaccount

# --- Email -----------------------------------------------------------------
# REQUIRED in production. This is the PLATFORM mailbox: every tenant on the
# default "platform" email mode sends its invitations, password resets,
# verification codes and booking emails through it. Tenants never see these
# values. Production must use EMAIL_PROVIDER=smtp; with it unset or "console",
# or with the host / from address / password missing, every send FAILS and is
# recorded in the delivery log (nothing is marked sent, nothing falls back to
# the console), and the backend logs "PLATFORM EMAIL IS NOT CONFIGURED" at
# boot. The From address of platform-mode mail is always MAIL_FROM_ADDRESS (use
# an address on a domain with SPF + DKIM + DMARC); the tenant's property name is
# only the display name.
#
# Any SMTP provider works (your web host, or a transactional provider such as
# Resend or Brevo): only these variables change, nothing else. All of them reach
# the backend automatically through env_file in docker-compose.prod.yml.
#   SMTP_HOST / SMTP_PORT   the provider's SMTP server (587 STARTTLS, or 465 TLS)
#   SMTP_SECURE             optional. true = implicit TLS, false = STARTTLS. Unset =
#                           by port (465 is TLS, anything else STARTTLS).
#   SMTP_USER / SMTP_PASS   the provider's SMTP credentials (never logged)
#   MAIL_FROM_ADDRESS       optional. The From address. Unset = SMTP_FROM, then
#                           SMTP_USER when it is an address, then lodgekeep@planmsys.com.
#   SMTP_FROM_NAME          optional display name
#   PLATFORM_REPLY_TO       optional. Reply-To of platform mail (sign-in codes,
#                           password resets, invitations, subscription and billing
#                           notices). Unset = info@planmsys.com; set to an empty
#                           value to send no Reply-To. Guest-facing hotel mail keeps
#                           the hotel's own contact as its Reply-To.
# The older names SMTP_PASSWORD and SMTP_FROM still work and need no change.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
SMTP_FROM_NAME=LodgeKeep
PLATFORM_REPLY_TO=
# Abuse limits for the platform mailbox only (a tenant on its own SMTP is not
# limited by us). Reservation and AR-invoice emails: per tenant per day, and
# per minute. Sign-in emails (staff invitations, password resets, the staff
# verification code) are exempt from the daily cap and have their own per-tenant
# per-minute limit and a per-recipient limit. Defaults shown.
PLATFORM_EMAIL_DAILY_CAP=500
PLATFORM_EMAIL_RATE_PER_MIN=30
PLATFORM_EMAIL_AUTH_RATE_PER_MIN=60
PLATFORM_EMAIL_RECIPIENT_LIMIT=10
PLATFORM_EMAIL_RECIPIENT_WINDOW_MIN=15
# Platform console → Backups emails the whole database through THIS server
# mailbox (never a hotel's own Setup → Email settings). With
# EMAIL_PROVIDER=console in production the Backups screen refuses to start a
# backup and says why. Largest encrypted attachment it will try to email
# (bytes; most mailboxes refuse over ~20-25 MB). Default 20 MB.
BACKUP_EMAIL_MAX_BYTES=
# NOTE: the automatic NIGHTLY off-site backup (restic -> Backblaze B2) is a
# separate, host-level job with its own root-only config in
# /etc/lodgekeep/backup.env. Nothing for it goes in this file. See RESTORE.md.

# --- Subscription billing (Planmsys charging a TENANT — a separate
#     merchant relationship from Cashiering above) -------------------------
BILLING_PAYSTACK_SECRET_KEY=
BILLING_PAYSTACK_PUBLIC_KEY=
BILLING_CARD_VERIFICATION_AMOUNT=50.00
SUBSCRIPTION_BILLING_SWEEP_INTERVAL_MS=60000
# Retry sweep for Paystack webhook events persisted but not yet decided
# (Paystack unreachable / transaction not final). Milliseconds.
PAYMENT_WEBHOOK_SWEEP_INTERVAL_MS=60000
# Upper bound for the Verify Transaction call a webhook makes to Paystack.
PAYSTACK_READ_TIMEOUT_MS=8000

# --- Tenant retention purge — PERMANENT deletion of offboarded tenants ------
# Leave OFF until backups are verified (ops/backup/restore-drill.sh must have
# printed PASS; procedure in RESTORE.md) and the deletion policy is legally
# reviewed. See backend/.env.example for the full description of each value.
TENANT_PURGE_ENABLED=false
TENANT_PURGE_DRY_RUN=false
TENANT_PURGE_SWEEP_INTERVAL_MS=300000
TENANT_PURGE_MAX_PER_TICK=1
TENANT_PURGE_TICK_BUDGET_MS=240000
TENANT_PURGE_MIN_RETENTION_DAYS=7

# --- Local-disk storage (paths INSIDE the backend container — each has a
#     matching named volume mounted onto it in docker-compose.prod.yml, so
#     uploaded files survive a container recreation) -----------------------
EXPORT_STORAGE_DIR=/app/storage/exports
IMPORT_STORAGE_DIR=/app/storage/imports
MENU_IMAGE_STORAGE_DIR=/app/storage/menu-images
# Property-branding logos (GET /api/v1/media/property-logos/:file, also
# used on the P&L PDF letterhead) — a fourth, previously undocumented
# storage var, the same pattern as the three above it.
PROPERTY_LOGO_STORAGE_DIR=/app/storage/property-logos

# Largest single folio payment accepted (default 10000000.00).
MAX_PAYMENT_AMOUNT=
