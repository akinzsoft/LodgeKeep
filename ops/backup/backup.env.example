# Template for /etc/lodgekeep/backup.env on the VPS (root:root, mode 600).
# install.sh creates the real file from this. NEVER commit the filled-in file.

# restic repository inside your Backblaze B2 bucket. The folder name after the
# second colon is free to choose; keep it stable.
RESTIC_REPOSITORY=b2:YOUR-BUCKET-NAME:lodgekeep-prod

# Backblaze application key (B2 console -> App Keys). Scope it to this one
# bucket. It needs list/read/write/delete (prune deletes old data).
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# The restic encryption passphrase. Everything in B2 is encrypted with it
# client-side. WITHOUT IT THE BACKUPS CANNOT BE OPENED, BY ANYONE. Store it in
# your password manager, NOT only on this server.
RESTIC_PASSWORD=

# Absolute path of the LodgeKeep checkout on the VPS (contains
# docker-compose.prod.yml and .env.production).
LODGEKEEP_DEPLOY_PATH=

# healthchecks.io check URL (https://hc-ping.com/<uuid>). The job pings /start,
# then success or /fail. No ping by the deadline means healthchecks.io alerts
# you, which also catches "the timer never ran". Optional but strongly advised.
HEALTHCHECK_URL=
