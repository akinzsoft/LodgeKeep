# Lodgekeep frontend — copy to .env and fill in if needed. Never commit .env.
#
# Local dev needs no values here at all: shared/api/client.js calls relative
# paths ("/api/v1/..."), and vite.config.js's dev-server proxy forwards them
# to the backend (backend/.env.example's PORT, default 3000) without
# rewriting the Host header — see that file's own comment for why that
# matters (src/auth/tenant-resolution.js on the backend reads it).
#
# Visit the dev server at http://alpha-hotels.localhost:5173 or
# http://beta-resorts.localhost:5173 (npm run dev), not plain
# localhost:5173 — see src/DevLoginForm.jsx.

# Only needed if the frontend and backend are NOT served from the same
# origin in a given environment (production topology isn't decided yet).
# Leave unset for local dev.
VITE_API_BASE_URL=

# The real, backend APP_DOMAIN value (backend/.env.example's own APP_DOMAIN),
# threaded through at BUILD time so tenant-url.js's post-signup redirect can
# tell "the bare APP_DOMAIN" apart from "an existing tenant subdomain of it"
# without guessing from window.location's own label count — that guess
# breaks the moment APP_DOMAIN is itself multi-level (lodgekeep.planmsys.com,
# not a bare lodgekeep.app). Leave unset for local dev — dev's own
# APP_DOMAIN ("localhost") is a single, unambiguous label, so tenant-url.js
# falls back to the label-counting guess safely. Set by
# docker-compose.prod.yml's own frontend.build.args in production, reusing
# that file's top-level APP_DOMAIN — never set this independently there.
VITE_APP_DOMAIN=

# Cloudflare Turnstile PUBLIC site key (SignupScreen.jsx) — security-review
# finding, CAPTCHA screening on POST /signup. Safe to expose: it is baked
# into the built JS bundle at BUILD time (Vite inlines import.meta.env.VITE_*
# statically), never read at request time. The matching SECRET key is
# backend-only (backend/.env.example's TURNSTILE_SECRET_KEY) and never
# appears here.
#
# Dev/test: Cloudflare's own OFFICIAL "always passes" dummy site key below
# — never a real production key. See
# developers.cloudflare.com/turnstile/troubleshooting/testing/.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
