# Lodgekeep backend — copy to .env and fill in. Never commit .env (SECURITY.md §1.1).
# Values below match docker-compose.yml at the repo root.

# Database ---------------------------------------------------------------
# Port 3310, not 3306: the compose file maps MySQL to a non-default host port
# to avoid colliding with other local MySQL instances. There is no silent
# fallback for host or port in knexfile.js — pointing migrations at the wrong
# server is too easy and too destructive to leave to a default.
DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=lodgekeep
DB_PASSWORD=change-me
DB_NAME=lodgekeep_dev

# The test schema is dropped and rebuilt from migrations on every test run.
# The name MUST contain "test" — knexfile.js and tests/helpers/global-setup.js
# both refuse to run otherwise (TESTING.md Part 1).
DB_NAME_TEST=lodgekeep_test

# Redis ------------------------------------------------------------------
# BullMQ job queue and rate-limit counters (ARCHITECTURE.md §14, §15).
# Infrastructure only — nothing durable lives here.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# Application ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Secrets — a secrets manager in every deployed environment, never the repo.
# The database and Redis credentials above are local-container values only.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# PLAN.md Phase 5 (Platform Foundation) — platform sessions are access-token-
# only, no refresh path (a deliberate Pass-1 simplification); modest on
# purpose (SECURITY.md §1.1: "no long-lived tokens for privileged roles").
JWT_PLATFORM_ACCESS_TTL=30m
# How long a single impersonation grant stays live before it must be
# re-started with a fresh, separately-audited reason (SECURITY.md §2's
# "time-bounded"). The impersonation-derived access token's own TTL is
# pinned to this.
IMPERSONATION_SESSION_MINUTES=60
# The TOTP issuer name shown in an authenticator app (src/auth/totp.js).
PLATFORM_MFA_ISSUER=LodgeKeep Platform
# How many days a self-service signup's trial lasts before the background
# sweep (src/jobs/trial-expiry.js) transitions it to suspended — read-only,
# never a hard lockout (PRODUCT_REQUIREMENTS.md §3.22).
TRIAL_PERIOD_DAYS=14

# src/shared/encryption.js — required to store or read a per-property email
# secret (email_settings.smtp_password_encrypted). A 32-byte key, base64
# encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every already-encrypted value undecryptable — back
# it up like any other production secret, never regenerate it casually.
ENCRYPTION_KEY=

# Paystack (src/modules/cashiering/paystack-adapter.js) — optional. With this
# unset, cash payments and every mocked/unit-tested Paystack code path still
# work; only the two tests requiring a real sandbox round trip skip, and
# POST /cashiering/folios/:id/payments/paystack fails at call time instead of
# succeeding. No live sandbox credentials are configured in this project's
# own dev environment as of Phase 2.5.
PAYSTACK_SECRET_KEY=

# Email (src/modules/notifications/email-adapter.js) — optional. With
# EMAIL_PROVIDER unset (or "console"), every outbox email is logged to
# stdout instead of sent — no credentials needed, the same dev-only
# convenience Paystack's own unset key falls back to. Set EMAIL_PROVIDER=smtp
# and the four values below to actually deliver mail through a real mailbox
# (e.g. your webhosting provider's own SMTP server).
#
# Landing in spam is usually a DNS/domain-authentication problem this app
# cannot fix from inside its own code — check that the SENDING domain (the
# part after @ in SMTP_USER/SMTP_FROM) has SPF and DKIM records naming your
# webhost's mail servers as authorized senders, and ideally a DMARC record.
# Most webhosting control panels (cPanel's "Email Deliverability" page, or
# similar) show whether these are already correctly configured.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER when unset — set this only if the "From" address
# should differ from the mailbox actually authenticating.
SMTP_FROM=
# Display name shown alongside the From address (defaults to "LodgeKeep").
# A bare mailbox address with no name is a real spam-classifier signal,
# same as sending HTML with no plain-text alternative (handled for you).
SMTP_FROM_NAME=

# The default subdomain a tenant logs in from, {slug}.APP_DOMAIN
# (PRODUCT_REQUIREMENTS.md §3.16). A tenant's own custom domain resolves
# through the tenant_domains table instead — see src/auth/tenant-resolution.js.
#
# Production: the real app domain (e.g. lodgekeep.app).
# Local dev: "localhost" — Express strips the port from req.hostname, and
# *.localhost always resolves to loopback (RFC 6761), so
# http://alpha-hotels.localhost:3000 and http://beta-resorts.localhost:3000
# work with no /etc/hosts entry. alpha-hotels and beta-resorts are the exact
# tenant slugs tests/helpers/fixtures.js seeds — the two symmetric example
# hotels this project uses everywhere instead of one reference customer
# (PRODUCT_REQUIREMENTS.md §1).
APP_DOMAIN=lodgekeep.app

# Subscription billing (src/modules/billing/paystack-gateway.js) — PLAN.md
# Phase 5. Deliberately a SEPARATE credential pair from PAYSTACK_SECRET_KEY
# above — that key is for guest-to-hotel payments (Cashiering); this one is
# Planmsys' own account charging a tenant for its subscription, a
# genuinely different merchant relationship. With this unset, every
# billing add-payment-method/recurring-charge call fails honestly with
# PAYMENT_GATEWAY_NOT_CONFIGURED rather than silently no-op'ing.
BILLING_PAYSTACK_SECRET_KEY=
BILLING_PAYSTACK_PUBLIC_KEY=
# The small, fully-refunded charge used only to capture a reusable card
# authorization when a tenant adds a payment method — never the real
# subscription price. Defaults to "50.00" (in the tenant's own base
# currency) if unset.
BILLING_CARD_VERIFICATION_AMOUNT=50.00
